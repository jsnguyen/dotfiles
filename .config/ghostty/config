theme = Dracula+

font-family = Nordwand Mono
font-size = 14
font-thicken = true
font-thicken-strength = 0

adjust-cell-height = -2%
adjust-cell-width = -2%

background-opacity = 0.92
background-blur = 15

window-padding-x = 10
window-padding-y = 10

cursor-style = block
cursor-style-blink = true
adjust-cursor-thickness = 2

macos-titlebar-style = tabs

window-colorspace = display-p3

unfocused-split-opacity = 0.45
